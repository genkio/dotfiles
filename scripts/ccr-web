<script>
const $ = (id) => document.getElementById(id);
const store = {
  get(k) { try { return localStorage.getItem(k); } catch { return null; } },
  set(k, v) { try { v == null ? localStorage.removeItem(k) : localStorage.setItem(k, v); } catch {} },
};
// A #t=... link sets the token once without it reaching the server log.
const m = location.hash.match(/[#&]t=([^&]+)/);
if (m) { store.set("ccr-token", decodeURIComponent(m[1])); history.replaceState(null, "", location.pathname); }
let token = store.get("ccr-token");
// Served under a route like /ccr, with or without the trailing slash.
const base = location.pathname.replace(/\\/?$/, "/");

async function api(path, body) {
  const r = await fetch(base + path, {
    method: body ? "POST" : "GET",
    headers: { "Authorization": "Bearer " + token, "Content-Type": "application/json" },
    body: body ? JSON.stringify(body) : undefined,
  });
  if (r.status === 401) { store.set("ccr-token", null); token = null; show(); throw new Error("bad token"); }
  return r.json();
}

const el = (tag, props) => Object.assign(document.createElement(tag), props);

function context(s) {
  const pct = Math.min(100, Math.round(100 * s.contextUsed / s.contextSize));
  const badge = el("span", {
    className: "badge ctx" + (pct >= 85 ? " full" : pct >= 60 ? " warn" : ""),
    textContent: pct + "%",
    title: "Context window used",
  });
  badge.style.setProperty("--pct", pct + "%");
  return badge;
}

function title(s) {
  const row = el("div", { className: "title" });
  row.append(el("span", { className: "name", textContent: s.name }));
  if (s.effort) row.append(el("span", { className: "badge", textContent: s.effort, title: "Effort" }));
  return row;
}

const STATUS = { busy: "working", shell: "bg jobs", idle: "idle" };

function spinner() {
  return el("span", { className: "spin", role: "status", ariaLabel: "Loading" });
}

// Shows a spinner in the button until the returned done() is called.
function busy(button, label) {
  const old = [...button.childNodes];
  button.disabled = true;
  button.replaceChildren(spinner(), ...(label ? [label] : []));
  return () => { button.disabled = false; button.replaceChildren(...old); };
}

function copyButton(text) {
  const b = el("button", { type: "button", className: "cmd", textContent: text, title: "Copy, then run on the mac to bring it to the foreground" });
  b.onclick = async (e) => {
    e.stopPropagation();
    try { await navigator.clipboard.writeText(text); } catch { return; }
    b.textContent = "Copied";
    b.classList.add("copied");
    setTimeout(() => { b.textContent = text; b.classList.remove("copied"); }, 1200);
  };
  return b;
}

function sessionRow(s) {
  const li = el("li", { title: "Tap to start another session in " + s.folder });
  const dot = el("span", { className: "dot " + s.status, title: STATUS[s.status] || s.status });
  const main = el("div", { className: "main" });
  const meta = el("div", { className: "meta" });
  meta.append(el("span", { className: "where", textContent: s.folder }));
  if (s.contextSize) meta.append(context(s));
  const actions = el("div", { className: "actions" });
  if (s.url) {
    const open = el("a", { className: "open", href: s.url, textContent: "Open in Claude ›" });
    open.onclick = (e) => e.stopPropagation();
    actions.append(open);
  }
  if (s.attach) actions.append(copyButton(s.attach));
  main.append(title(s), meta, actions);
  const end = el("button", { type: "button", className: "end", textContent: "×", title: "End session" });
  end.setAttribute("aria-label", "End " + s.name);
  end.onclick = async (e) => {
    e.stopPropagation();
    if (!confirm("End " + s.name + "?\\n\\nAny background jobs in it are stopped too.")) return;
    busy(end);
    const out = $("out");
    try {
      const r = await api("end", { id: s.id });
      out.className = r.ok ? "ok" : "bad";
      out.textContent = r.output;
    } catch (err) {
      out.className = "bad"; out.textContent = String(err.message || err);
    }
    loadSessions();
  };
  li.append(dot, main, end);
  // Tap to reuse the folder for another session there.
  li.onclick = () => { $("path").value = s.folder; $("path").scrollIntoView({ block: "center" }); $("path").focus({ preventScroll: true }); };
  return li;
}

let loading = false;
// Quiet loads come from the timer and leave the Refresh button alone.
async function loadSessions(quiet) {
  if (loading) return;
  loading = true;
  const done = quiet === true ? () => {} : busy($("refresh"));
  const ul = $("sessions");
  let sessions;
  try {
    ({ sessions } = await api("sessions"));
  } catch (err) {
    if (token && !ul.querySelector("li:not(.empty)")) ul.replaceChildren(el("li", { className: "empty bad", textContent: "Could not load sessions." }));
    return;
  } finally { loading = false; done(); }
  $("count").textContent = sessions.length ? String(sessions.length) : "";
  if (!sessions.length) {
    ul.replaceChildren(el("li", { className: "empty", textContent: "No sessions running." }));
    return;
  }
  ul.replaceChildren(...sessions.map(sessionRow));
}

async function show() {
  $("auth").hidden = !!token;
  $("form").hidden = !token;
  if (!token) return;
  $("path").value = store.get("ccr-path") || "";
  try {
    const { projects } = await api("projects");
    $("projects").replaceChildren(...projects.map((p) => Object.assign(document.createElement("option"), { value: p })));
  } catch {}
  loadSessions();
}

$("save").onclick = () => { token = $("token").value.trim(); if (token) { store.set("ccr-token", token); show(); } };
$("refresh").onclick = () => loadSessions();
document.addEventListener("visibilitychange", () => { if (!document.hidden && token) loadSessions(); });
setInterval(() => { if (!document.hidden && token) loadSessions(true); }, 15000);
$("forget").onclick = () => { store.set("ccr-token", null); token = null; show(); };
$("form").onsubmit = async (e) => {
  e.preventDefault();
  const out = $("out");
  out.className = ""; out.textContent = "";
  const done = busy($("go"), "Starting…");
  store.set("ccr-path", $("path").value.trim());
  try {
    const r = await api("start", { path: $("path").value.trim(), effort: $("effort").value });
    out.className = r.ok ? "ok" : "bad";
    out.textContent = r.output || (r.ok ? "Started." : "Failed.");
  } catch (err) {
    out.className = "bad"; out.textContent = String(err.message || err);
  } finally {
    done();
    loadSessions();
  }
};
show();
</script>
</body>
</html>
"""


class Handler(BaseHTTPRequestHandler):
    server_version = "ccr-web"
    sys_version = ""

    def log_message(self, fmt, *args):
        sys.stderr.write("%s %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), fmt % args))

    def send(self, code, body, ctype="application/json"):
        data = body.encode() if isinstance(body, str) else json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype + "; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        self.end_headers()
        self.wfile.write(data)

    def authorized(self):
        got = self.headers.get("Authorization", "")
        try:
            want = "Bearer " + read_token()
        except OSError:
            return False
        if hmac.compare_digest(got.encode(), want.encode()):
            return True
        # Funnel is public, so slow down guessing.
        with fail_lock:
            time.sleep(1)
        return False

    def do_GET(self):
        path = urlsplit(self.path).path
        if path == "/":
            self.send(200, PAGE, "text/html")
        elif path == "/projects":
            if not self.authorized():
                return self.send(401, {"error": "unauthorized"})
            self.send(200, {"projects": trusted_projects()})
        elif path == "/sessions":
            if not self.authorized():
                return self.send(401, {"error": "unauthorized"})
            self.send(200, {"sessions": running_sessions()})
        else:
            self.send(404, {"error": "not found"})

    def do_POST(self):
        route = urlsplit(self.path).path
        if route not in ("/start", "/end"):
            return self.send(404, {"error": "not found"})
        if not self.authorized():
            return self.send(401, {"error": "unauthorized"})
        try:
            n = int(self.headers.get("Content-Length", "0"))
            req = json.loads(self.rfile.read(min(n, 4096)) or b"{}")
        except Exception:
            return self.send(400, {"ok": False, "output": "bad request"})

        if route == "/end":
            sid = str(req.get("id", ""))
            if not sid:
                return self.send(400, {"ok": False, "output": "bad session"})
            with start_lock:
                ok, out = end_session(sid)
            self.log_message("end %s -> %s", sid, out)
            return self.send(200, {"ok": ok, "output": out})

        path = str(req.get("path", "")).strip()
        if not path or path.startswith("-") or "\n" in path:
            return self.send(400, {"ok": False, "output": "bad path"})
        effort = req.get("effort") or ""
        if effort and effort not in EFFORTS:
            return self.send(400, {"ok": False, "output": "bad effort"})

        with start_lock:
            ok, out = start_session(path, effort)
        self.log_message("start %s -> %s", path, out.splitlines()[0] if out else "")
        self.send(200, {"ok": ok, "output": out})


def main():
    read_token()
    ThreadingHTTPServer(("127.0.0.1", PORT), Handler).serve_forever()


if __name__ == "__main__":
    main()
