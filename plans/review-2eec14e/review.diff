diff --git a/sketchybar/.config/sketchybar/plugins/aerospace.sh b/sketchybar/.config/sketchybar/plugins/aerospace.sh
new file mode 100755
index 0000000..6c0baa9
--- /dev/null
+++ b/sketchybar/.config/sketchybar/plugins/aerospace.sh
@@ -0,0 +1,23 @@
+#!/bin/sh
+
+# $1 is this item's workspace id, baked into the script line in sketchybarrc.
+# The event payload carries the workspaces worth showing and the focused one;
+# spaces-sync.sh decides what "worth showing" means.
+
+case ",$VISIBLE_WORKSPACES," in
+  *",$1,"*) drawing=on ;;
+  *)        drawing=off ;;
+esac
+
+if [ "$1" = "$FOCUSED_WORKSPACE" ]; then
+  border=0xffffffff
+  fill=0x30ffffff
+else
+  border=0x60ffffff
+  fill=0x00000000
+fi
+
+sketchybar --set "$NAME" \
+           drawing="$drawing" \
+           background.border_color="$border" \
+           background.color="$fill"
diff --git a/sketchybar/.config/sketchybar/plugins/clock.sh b/sketchybar/.config/sketchybar/plugins/clock.sh
new file mode 100755
index 0000000..6cc739b
--- /dev/null
+++ b/sketchybar/.config/sketchybar/plugins/clock.sh
@@ -0,0 +1,8 @@
+#!/bin/sh
+
+# The $NAME variable is passed from sketchybar and holds the name of
+# the item invoking this script:
+# https://felixkratz.github.io/SketchyBar/config/events#events-and-scripting
+
+sketchybar --set "$NAME" label="$(date '+%d/%m %H:%M')"
+
diff --git a/sketchybar/.config/sketchybar/plugins/volume.sh b/sketchybar/.config/sketchybar/plugins/volume.sh
new file mode 100755
index 0000000..5f47f0d
--- /dev/null
+++ b/sketchybar/.config/sketchybar/plugins/volume.sh
@@ -0,0 +1,7 @@
+#!/bin/sh
+
+# The volume_change event supplies the current volume percentage in $INFO.
+
+if [ "$SENDER" = "volume_change" ]; then
+  sketchybar --set "$NAME" label="$INFO%"
+fi
diff --git a/sketchybar/.config/sketchybar/sketchybarrc b/sketchybar/.config/sketchybar/sketchybarrc
new file mode 100755
index 0000000..b8cbeb4
--- /dev/null
+++ b/sketchybar/.config/sketchybar/sketchybarrc
@@ -0,0 +1,68 @@
+PLUGIN_DIR="$CONFIG_DIR/plugins"
+
+# AeroSpace starts sketchybar with the login PATH, which has no Homebrew in it.
+# Exporting here would not reach the click scripts either - those are spawned by
+# the sketchybar daemon, with its own environment - so they get an absolute path.
+PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
+AEROSPACE="$(command -v aerospace)"
+
+sketchybar --bar position=top height=40 blur_radius=30 color=0x40000000
+
+default=(
+  padding_left=5
+  padding_right=5
+  icon.drawing=off
+  label.font=".AppleSystemUIFont:Bold:14.0"
+  label.color=0xffffffff
+  label.padding_left=4
+  label.padding_right=4
+)
+sketchybar --default "${default[@]}"
+
+##### AeroSpace workspaces #####
+# AeroSpace workspaces are not mission control spaces, so the `space` component
+# cannot track them and these are plain items. The list comes from AeroSpace,
+# and both the highlight and which of them draw at all are pushed in by
+# spaces-sync.sh through the custom event - hence drawing=off to start with.
+
+sketchybar --add event aerospace_workspace_change
+
+for sid in $(aerospace list-workspaces --all)
+do
+  # Outlined boxes, after AeroSpace's own menu bar indicator. Its focused
+  # workspace has a dashed border, which sketchybar cannot draw, so the plugin
+  # marks focus with a brighter outline and a faint fill instead.
+  workspace=(
+    label="$sid"
+    label.padding_left=7
+    label.padding_right=7
+    background.drawing=on
+    background.color=0x00000000
+    background.border_width=1
+    background.border_color=0x60ffffff
+    background.corner_radius=4
+    background.height=22
+    drawing=off
+    script="$PLUGIN_DIR/aerospace.sh $sid"
+    click_script="$AEROSPACE workspace $sid"
+  )
+  sketchybar --add item space."$sid" left \
+             --set space."$sid" "${workspace[@]}" \
+             --subscribe space."$sid" aerospace_workspace_change
+done
+
+##### Right items #####
+# First added is rightmost. The clock runs on a fixed cycle; volume only when
+# the system volume actually changes.
+
+sketchybar --add item clock right \
+           --set clock update_freq=10 script="$PLUGIN_DIR/clock.sh" \
+           --add item volume right \
+           --set volume script="$PLUGIN_DIR/volume.sh" \
+           --subscribe volume volume_change
+
+sketchybar --update
+
+# The workspace items have no event payload yet, so nothing would be drawn until
+# the first switch. `force` is what gets past the sync's memo of a past session.
+"$HOME/.config/aerospace/scripts/spaces-sync.sh" force
