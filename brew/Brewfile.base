in_vm = `/usr/sbin/sysctl -n kern.hv_vmm_present 2>/dev/null`.strip == "1" ||
        `/usr/sbin/sysctl -n hw.model 2>/dev/null`.strip.match?(/VirtualMac|VMware|Parallels|QEMU/i)

brew "bat"
brew "eza"
brew "fd"
brew "genkio/tap/carbonyl"
brew "genkio/tap/cc-imessage"
brew "genkio/tap/herdlet"
brew "htop"
brew "jq"
brew "pam-reattach" unless in_vm
brew "pngpaste" unless in_vm
brew "ripgrep"
brew "stow"
brew "tlrc"
brew "tmux"
brew "tmuxp"
brew "unar"
brew "viu"
brew "zoxide"
