#!/usr/bin/env python3
# ccr-web - a small page that starts, lists and ends Remote Control Claude
# sessions, so the phone app can pick them up, served through Tailscale serve
# or funnel. Stdlib only: launchd runs it with the system python.

import glob
import hmac
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlsplit

HOME = os.path.expanduser("~")
TOKEN_FILE = os.environ.get(
    "CCR_WEB_TOKEN_FILE",
    os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config")), "dotfiles", "ccr-web.token"),
)
PORT = int(os.environ.get("CCR_WEB_PORT", "52540"))
EFFORTS = ("low", "medium", "high", "xhigh", "max")

# One start at a time, so two taps cannot race for the same agent name.
start_lock = threading.Lock()
# Effort passed to sessions started here, by short id, for the gap before
# their first turn lands in the transcript.
started_effort = {}
fail_lock = threading.Lock()


def read_token():
    with open(TOKEN_FILE) as f:
        return f.read().strip()


def home_relative(path):
    if path == HOME:
        return "~"
    if path.startswith(HOME + "/"):
        return path[len(HOME) + 1:]
    return path


def run_json(args):
    try:
        p = subprocess.run(args, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                           stderr=subprocess.DEVNULL, timeout=15)
        return json.loads(p.stdout or b"null")
    except Exception:
        return None


CLAUDE = os.environ.get("CLAUDE_BIN") or shutil.which("claude") or os.path.join(HOME, ".local", "bin", "claude")


def claude_agents():
    return [a for a in run_json([CLAUDE, "agents", "--json"]) or [] if a.get("kind") in ("interactive", "background")]


def session_file(pid):
    try:
        with open(os.path.join(HOME, ".claude", "sessions", "%s.json" % pid)) as f:
            return json.load(f)
    except Exception:
        return {}


def transcript_effort(session_id):
    paths = glob.glob(os.path.join(HOME, ".claude", "projects", "*", "%s.jsonl" % session_id))
    if not paths:
        return ""
    # Each assistant turn records the effort it ran at; the last one is current.
    try:
        with open(paths[0], "rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            for chunk in (256 << 10, 4 << 20):
                f.seek(max(0, size - chunk))
                for line in reversed(f.read().splitlines()):
                    if b'"perTurnEffort"' not in line:
                        continue
                    try:
                        d = json.loads(line)
                    except ValueError:
                        continue
                    if d.get("type") == "assistant" and d.get("effort"):
                        return d["effort"]
                if chunk >= size:
                    break
    except OSError:
        pass
    return ""


def argv_effort(pid):
    try:
        argv = subprocess.run(["ps", "-o", "command=", "-p", str(pid)], stdout=subprocess.PIPE,
                              timeout=5).stdout.decode().split()
    except Exception:
        return ""
    return argv[argv.index("--effort") + 1] if "--effort" in argv[:-1] else ""


def session_effort(a):
    return (transcript_effort(a.get("sessionId", "")) or started_effort.get(a.get("id"))
            or argv_effort(a.get("pid")))


def session_row(a):
    f = session_file(a.get("pid"))
    bridge = f.get("bridgeSessionId") or ""
    # `claude agents` reports "shell" (waiting, background jobs still up) as
    # busy; the session file keeps them apart.
    status = f.get("status") if f.get("status") in ("busy", "shell", "idle") else a.get("status", "")
    return {
        "id": a.get("sessionId", ""), "name": a.get("name", ""), "folder": home_relative(a.get("cwd", "")),
        "status": status, "startedAt": a.get("startedAt", 0), "kind": a.get("kind", ""),
        "attach": "claude attach %s" % a["id"] if a.get("kind") == "background" and a.get("id") else "",
        # The iOS app claims claude.ai/code/* as a universal link.
        "url": "https://claude.ai/code/%s" % bridge if bridge.startswith("session_") else "",
        "effort": session_effort(a),
    }


def running_sessions():
    return sorted((session_row(a) for a in claude_agents()), key=lambda a: a["startedAt"], reverse=True)


def trusted(path):
    try:
        with open(os.path.join(HOME, ".claude.json")) as f:
            projects = json.load(f).get("projects", {})
    except Exception:
        return True
    return bool(projects.get(path, {}).get("hasTrustDialogAccepted"))


def start_session(arg, effort):
    # Paths are relative to home so the phone only has to send "code/hq-dev".
    if arg == "~":
        path = HOME
    elif arg.startswith("~/"):
        path = os.path.join(HOME, arg[2:])
    else:
        path = os.path.join(HOME, arg)
    if not os.path.isdir(path):
        return False, "no such directory: %s" % path
    path = os.path.realpath(path)
    # An untrusted folder stops at the trust prompt, which nobody can answer
    # from the phone, so refuse up front instead of leaving a stuck session.
    if not trusted(path):
        return False, "%s is not trusted yet - start claude there once on the mac" % path

    agents = run_json([CLAUDE, "agents", "--json"]) or []
    base = re.sub(r"[^a-z0-9_-]", "-", os.path.basename(path).lower())[:32] or "session"
    used = {a.get("name") for a in agents}
    name, n = base, 2
    while name in used:
        name, n = "%s-%d" % (base[:29], n), n + 1

    args = [CLAUDE, "--bg", "--name", name]
    if effort:
        args += ["--effort", effort]
    # --remote-control takes an optional value, so it goes last.
    args += ["--remote-control", name]
    try:
        p = subprocess.run(args, cwd=path, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                           stderr=subprocess.STDOUT, timeout=60)
    except subprocess.TimeoutExpired:
        return False, "claude did not start in time"
    out = p.stdout.decode(errors="replace").strip()
    if p.returncode != 0:
        return False, "claude did not start: %s" % out
    m = re.search(r"^backgrounded · ([0-9a-f]+)", out, re.M)
    if m and effort:
        started_effort[m.group(1)] = effort
    lines = ["started %s" % name, path]
    if m:
        lines.append("claude attach %s" % m.group(1))
    return True, "\n".join(lines)


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def process_groups_under(pid):
    try:
        ps = subprocess.run(["ps", "-axo", "pid=,ppid=,pgid="], stdout=subprocess.PIPE, timeout=5).stdout.decode()
    except Exception:
        return set()
    children, pgid = {}, {}
    for line in ps.splitlines():
        try:
            p, pp, g = map(int, line.split())
        except ValueError:
            continue
        children.setdefault(pp, []).append(p)
        pgid[p] = g
    tree, todo = set(), [pid]
    while todo:
        p = todo.pop()
        tree.add(p)
        todo.extend(children.get(p, []))
    # A group that also holds outside processes, like the launching shell's,
    # is not ours to kill.
    return {g for g in {pgid.get(p, p) for p in tree}
            if all(p in tree for p, pg in pgid.items() if pg == g)}


def kill_groups(groups, sig):
    for g in groups:
        try:
            os.killpg(g, sig)
        except OSError:
            pass


def end_session(session_id):
    agent = next((a for a in claude_agents() if a.get("sessionId") == session_id), None)
    if not agent:
        return False, "not running"
    # A background session has no pid for its first moments; `claude stop`
    # only needs the id.
    pid, name = int(agent.get("pid") or 0), agent.get("name") or session_id
    background = agent.get("kind") == "background" and agent.get("id")
    if not pid and not background:
        return False, "not running"
    # Taken up front: background jobs run in their own groups and get
    # reparented once claude is gone.
    groups = process_groups_under(pid) if pid else set()

    # An interactive claude exits on SIGTERM without the background-jobs
    # prompt and stops those jobs itself. `claude stop` keeps a background
    # session resumable but leaves its jobs running, hence the sweep below.
    stopped = False
    if background:
        stopped = subprocess.run([CLAUDE, "stop", agent["id"]], stdin=subprocess.DEVNULL,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=15).returncode == 0
    if not pid:
        return stopped, "ended %s" % name if stopped else "could not stop %s" % name
    if not stopped:
        os.kill(pid, signal.SIGTERM)
    deadline = time.time() + 10
    while alive(pid) and time.time() < deadline:
        time.sleep(0.25)
    forced = alive(pid)
    if forced:
        os.kill(pid, signal.SIGKILL)

    groups.discard(os.getpgrp())
    kill_groups(groups, signal.SIGTERM)
    time.sleep(1)
    kill_groups(groups, signal.SIGKILL)
    return True, "ended %s%s" % (name, " (forced)" if forced else "")


def trusted_projects():
    try:
        with open(os.path.join(HOME, ".claude.json")) as f:
            projects = json.load(f).get("projects", {})
    except Exception:
        return []
    out = []
    for path, p in projects.items():
        if not p.get("hasTrustDialogAccepted") or not os.path.isdir(path):
            continue
        if path == HOME or path.startswith(HOME + "/"):
            out.append(home_relative(path))
    return sorted(out)


PAGE = """<!doctype html>
<html lang="en">
