in_vm = `/usr/sbin/sysctl -n kern.hv_vmm_present 2>/dev/null`.strip == "1" ||
        `/usr/sbin/sysctl -n hw.model 2>/dev/null`.strip.match?(/VirtualMac|VMware|Parallels|QEMU/i)

on_silicon = `/usr/sbin/sysctl -n hw.optional.arm64 2>/dev/null`.strip == "1"

# The CLIs that self-publish macOS binaries (fastfetch, fzf, lnav, neovim,
# sevenzip, yazi) come from mise on both architectures now, so Intel and Apple
# Silicon run the same versions: mise/.config/mise/config.toml, pinned by
# mise.lock. Homebrew stopped bottling macOS x86_64, and keeping them here
# meant one machine poured a bottle while the other compiled a whole Rust or Go
# toolchain. `mise` itself still comes from brew on Apple Silicon; Intel
# bootstraps it from a pinned tarball (install-intel-prebuilt.sh bootstrap),
# because the mise formula would build Rust from source there. Mole stays off
# Intel: its release ships several artifacts rather than one self-contained
# archive.

brew "bat"
brew "eza"
brew "fd"
brew "ffmpeg" unless in_vm
brew "genkio/tap/carbonyl"
brew "genkio/tap/cc-imessage"
brew "genkio/tap/herdlet"
brew "htop"
brew "jq"
brew "mise" if on_silicon
brew "mole" if on_silicon
brew "mpv" unless in_vm
# lets pam_tid (Touch ID for sudo) work inside tmux; macos-bootstrap.sh installs
# it itself (it runs before this bundle) and needs it on disk before referencing
# it in /etc/pam.d/sudo_local; listed here so it stays managed and upgraded
brew "pam-reattach" unless in_vm
# clipboard image -> stdout for tmux/bin/clip-png.sh (prefix + V); the script
# falls back to osascript, which is slower and re-encodes, when it is missing
brew "pngpaste" unless in_vm
brew "ripgrep"
brew "stow"
brew "tailscale" if on_silicon
# Intel: no bottle, and upstream ships no CLI tarball for macOS. The signed
# universal pkg puts the same CLI at /usr/local/bin/tailscale and runs the
# daemon as a system extension, so tailscale-up.sh and tailscale-exit.sh keep
# working; only `brew services` does not apply.
cask "tailscale-app" unless on_silicon
brew "tldr"
brew "tmux"
brew "tmuxp"
brew "unar"
brew "viu"
brew "zoxide"
