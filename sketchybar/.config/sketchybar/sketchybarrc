PLUGIN_DIR="$CONFIG_DIR/plugins"

PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
AEROSPACE="$(command -v aerospace)"

sketchybar --bar position=bottom height=40 blur_radius=30 color=0x40000000

default=(
  padding_left=3
  padding_right=3
  icon.drawing=off
  label.font=".AppleSystemUIFont:Regular:14.0"
  label.color=0xffffffff
  label.padding_left=3
  label.padding_right=3
)
sketchybar --default "${default[@]}"

sketchybar --add event aerospace_workspace_change

for sid in 1 2 3 4 5 6 7 8 9
do
  workspace=(
    label="$sid"
    label.padding_left=7
    label.padding_right=7
    background.drawing=on
    background.color=0x00000000
    background.border_width=1
    background.border_color=0x60ffffff
    background.corner_radius=4
    background.height=22
    drawing=off
    script="$PLUGIN_DIR/aerospace.sh $sid"
    click_script="$AEROSPACE workspace $sid"
  )
  sketchybar --add item space."$sid" left \
             --set space."$sid" "${workspace[@]}" \
             --subscribe space."$sid" aerospace_workspace_change
done

sketchybar --add item quit right \
           --set quit label="-" \
                 click_script="$HOME/.config/aerospace/scripts/quit.sh"

sketchybar --add item clock right \
           --set clock update_freq=10 script="$PLUGIN_DIR/clock.sh"

sketchybar --add item input_source right \
           --set input_source \
                 script="$PLUGIN_DIR/input-source.sh" \
           --subscribe input_source front_app_switched

sketchybar --add item volume right \
           --set volume script="$PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change

sketchybar --add item battery right \
           --set battery update_freq=120 drawing=off \
                 script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery power_source_change system_woke

sketchybar --add item agent_usage right \
           --set agent_usage update_freq=180 drawing=off \
                 script="$PLUGIN_DIR/agent-usage.sh" \
           --subscribe agent_usage system_woke

sketchybar --add item maestral right \
           --set maestral update_freq=30 drawing=off \
                 script="$PLUGIN_DIR/maestral.sh" \
           --subscribe maestral system_woke

sketchybar --add item network right \
           --set network update_freq=10 drawing=off \
                 script="$PLUGIN_DIR/network.sh"

sketchybar --add item spaces_heartbeat right \
           --set spaces_heartbeat drawing=off update_freq=30 \
                 script="$HOME/.config/aerospace/scripts/spaces-sync.sh"

sketchybar --update

"$HOME/.config/aerospace/scripts/sync.sh" force
