in_vm = `/usr/sbin/sysctl -n kern.hv_vmm_present 2>/dev/null`.strip == "1" ||
        `/usr/sbin/sysctl -n hw.model 2>/dev/null`.strip.match?(/VirtualMac|VMware|Parallels|QEMU/i)

on_silicon = `/usr/sbin/sysctl -n hw.optional.arm64 2>/dev/null`.strip == "1"

# No macOS x86_64 bottles and a Go or Rust toolchain to build first, so on Intel
# these come from scripts/install-intel-prebuilt.sh instead. See Brewfile.base.

brew "awscli"
brew "gh" if on_silicon
brew "git-delta"
brew "gnupg"
brew "lazydocker" unless in_vm
brew "lazygit" if on_silicon
brew "lazysql" if on_silicon
brew "mise" if on_silicon

# Pi coding agent, installed from the pinned npm tarball and wrapped with
# PI_SKIP_VERSION_CHECK=1 by the formula. Update it with `brew upgrade`, never
# `pi update`: a self-update drops a second copy into Homebrew's node_modules
# and breaks the formula.
brew "pi-coding-agent"

# alacritty: cask disabled upstream 2026-09-01 (fails_gatekeeper_check) because
# the dmg is ad-hoc signed and not notarized. scripts/install-alacritty.sh
# installs it from the pinned upstream release instead; restore the cask here
# when Homebrew re-enables it.
cask "codex"
cask "orbstack" unless in_vm
