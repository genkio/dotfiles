diff --git a/aerospace/.config/aerospace/scripts/spaces-sync.sh b/aerospace/.config/aerospace/scripts/spaces-sync.sh
new file mode 100755
index 0000000..075588d
--- /dev/null
+++ b/aerospace/.config/aerospace/scripts/spaces-sync.sh
@@ -0,0 +1,35 @@
+#!/bin/sh
+
+# Push the workspace indicator's state into sketchybar: the focused workspace,
+# and which workspaces are worth a number at all - the ones holding windows,
+# plus the focused one even when empty, so a switch to an empty workspace still
+# highlights something. One workspace in use needs no indicator, so the list
+# goes empty and the whole thing disappears.
+#
+# The memo keeps a focus change that changed nothing from re-running an item
+# script per workspace. `force` is for sketchybarrc, whose fresh items have to
+# be painted whatever a past session left in the memo.
+
+PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
+
+MEMO="${TMPDIR:-/tmp}/aerospace-spaces-state"
+
+focused="$(aerospace list-workspaces --focused)"
+visible="$(
+  { aerospace list-workspaces --monitor all --empty no; printf '%s\n' "$focused"; } \
+    | sort -u
+)"
+
+[ "$(printf '%s\n' "$visible" | grep -c .)" -gt 1 ] || visible=""
+visible="$(printf '%s' "$visible" | paste -sd, -)"
+
+state="$focused|$visible"
+if [ "$1" != force ] && [ "$(cat "$MEMO" 2>/dev/null)" = "$state" ]; then
+  exit 0
+fi
+
+sketchybar --trigger aerospace_workspace_change \
+           FOCUSED_WORKSPACE="$focused" \
+           VISIBLE_WORKSPACES="$visible"
+
+printf '%s' "$state" > "$MEMO"
