#!/bin/sh
# ccr - start a Claude session at PATH in a new Herdr tab so the phone app can
# pick it up. Fired from Quick Run over ssh, where there is no tty and no
# interactive shell, so this is a script rather than a shell alias.

set -eu

PY=/usr/bin/python3
command -v python3 >/dev/null 2>&1 && PY=python3
[ -x "$(command -v "$PY" 2>/dev/null || echo "$PY")" ] || { echo "ccr: python3 not found" >&2; exit 1; }

CLAUDE="${CLAUDE_BIN:-}"
[ -n "$CLAUDE" ] || CLAUDE="$(command -v claude 2>/dev/null || true)"
[ -n "$CLAUDE" ] || CLAUDE="$HOME/.local/bin/claude"
[ -x "$CLAUDE" ] || { echo "ccr: claude not found" >&2; exit 1; }

HERDR="${HERDR_BIN:-}"
[ -n "$HERDR" ] || HERDR="$(command -v herdr 2>/dev/null || true)"
[ -n "$HERDR" ] || HERDR="$HOME/.local/share/mise/shims/herdr"
[ -x "$HERDR" ] || { echo "ccr: herdr not found" >&2; exit 1; }

usage="ccr: usage: ccr <path-under-home> [-el|-em|-eh|-ex|-emax] [-o]"
arg=""
effort=""
orch=""
# Flags may come before or after the path.
for a in "$@"; do
  case "$a" in
    -el) effort=low ;;
    -em) effort=medium ;;
    -eh) effort=high ;;
    -ex) effort=xhigh ;;
    -emax) effort=max ;;
    -o) orch=1 ;;
    -*) echo "ccr: unknown option: $a" >&2; echo "$usage" >&2; exit 1 ;;
    *) [ -z "$arg" ] || { echo "$usage" >&2; exit 1; }; arg="$a" ;;
  esac
done
[ -n "$arg" ] || { echo "$usage" >&2; exit 1; }

# Paths are relative to home so the phone only has to send "code/hq-dev".
case "$arg" in
  /*) dir="$arg" ;;
  '~') dir="$HOME" ;;
  '~/'*) dir="$HOME/${arg#\~/}" ;;
  *) dir="$HOME/$arg" ;;
esac
[ -d "$dir" ] || { echo "ccr: no such directory: $dir" >&2; exit 1; }
dir="$(cd "$dir" && pwd -P)"

# An untrusted folder stops at the trust prompt, which nobody can answer from
# the phone, so refuse up front instead of leaving a stuck pane behind.
if ! "$PY" - "$dir" <<'PY'
import json, os, sys
try:
    d = json.load(open(os.path.expanduser("~/.claude.json")))
except Exception:
    sys.exit(0)
sys.exit(0 if d.get("projects", {}).get(sys.argv[1], {}).get("hasTrustDialogAccepted") else 1)
PY
then
  echo "ccr: $dir is not trusted yet - start claude there once on the mac" >&2
  exit 1
fi

agents="$("$HERDR" agent list 2>/dev/null || echo '{}')"

existing="$(printf '%s' "$agents" | "$PY" -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for a in d.get("result", {}).get("agents", []):
    if a.get("cwd") == sys.argv[1]:
        print(a.get("name") or a.get("pane_id"))
        break
' "$dir")"
if [ -n "$existing" ]; then
  echo "ccr: already running at $dir ($existing)"
  exit 0
fi

# Herdr agent names are [a-z][a-z0-9_-]{0,31} and unique among live agents.
name="$(printf '%s' "$agents" | "$PY" -c '
import json, re, sys
base = re.sub(r"[^a-z0-9_-]", "-", sys.argv[1].lower())[:32]
if not re.match(r"^[a-z]", base):
    base = "s" + base[:31]
try:
    used = {a.get("name") for a in json.load(sys.stdin).get("result", {}).get("agents", [])}
except Exception:
    used = set()
name, n = base, 2
while name in used:
    name, n = "%s-%d" % (base[:29], n), n + 1
print(name)
' "$(basename "$dir")")"

ws="${HERDR_WORKSPACE_ID:-}"
if [ -z "$ws" ]; then
  ws="$("$HERDR" workspace list | "$PY" -c '
import json, sys
w = json.load(sys.stdin).get("result", {}).get("workspaces", [])
if not w:
    sys.exit(1)
print(next((x for x in w if x.get("focused")), w[0])["workspace_id"])
')"
fi

pane="$("$HERDR" tab create --workspace "$ws" --cwd "$dir" --label "$name" --no-focus | "$PY" -c '
import json, sys
print(json.load(sys.stdin)["result"]["root_pane"]["pane_id"])
')"

# --remote-control takes an optional value, so it goes last.
set --
[ -z "$effort" ] || set -- --effort "$effort"
[ -z "$orch" ] || set -- "$@" --append-system-prompt-file "$HOME/.claude/prompts/orchestrator.md"
if ! "$HERDR" agent start "$name" --kind claude --pane "$pane" -- "$@" --remote-control "$name" >/dev/null 2>&1; then
  echo "ccr: claude did not come up in $pane - check that tab on the mac" >&2
  exit 1
fi

# Claude suffixes the name it registers, so report the one the app will list.
shown="$name"
i=0
while [ "$i" -lt 10 ]; do
  found="$("$CLAUDE" agents --json 2>/dev/null | "$PY" -c '
import json, sys
try:
    rows = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for a in rows:
    if a.get("cwd") == sys.argv[1] and a.get("kind") == "interactive":
        print(a.get("name", ""))
        break
' "$dir" 2>/dev/null || true)"
  [ -n "$found" ] && { shown="$found"; break; }
  sleep 1
  i=$((i + 1))
done

echo "ccr: started $shown"
echo "ccr: $dir"
