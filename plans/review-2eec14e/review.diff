+#!/bin/sh
+
+# Every hook lands here: workspace change, focus change, fullscreen toggle.
+# Both halves memoize, so calling this more often than strictly needed is cheap.
+
+"$(dirname "$0")/spaces-sync.sh"
+"$(dirname "$0")/chrome-sync.sh"
